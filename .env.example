# Server
HOST=127.0.0.1
PORT=4178
DATA_DIR=./data

# Keep AUTH_MODE=proxy in production and inject this header only from a trusted local gateway.
AUTH_MODE=off
TRUSTED_PROXY_HEADER=x-transcomic-admin
TRUSTED_PROXY_VALUE=1

# Translation backend: codex-cli uses an existing Codex login; openai uses the API key below.
TRANSLATION_BACKEND=codex-cli
CODEX_CLI_PATH=codex
CODEX_TIMEOUT_SECONDS=300

# OpenAI-compatible fallback
OPENAI_API_KEY=
TRANSLATION_MODEL_FAST=gpt-5.6-luna
TRANSLATION_MODEL_BALANCED=gpt-5.6-terra
TRANSLATION_MODEL_QUALITY=gpt-5.6-sol
MAX_IMAGE_EDGE=2048

# Authorized Comix browser connector
COMIX_PROXY_URL=
COMIX_BOOTSTRAP_URL=https://comix.to/title/n9vgy
PATCHRIGHT_EXECUTABLE_PATH=
BROWSER_HEADLESS=1
